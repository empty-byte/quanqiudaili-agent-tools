{
  "name": "quanqiudaili-agent-tools",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/empty-byte/quanqiudaili-agent-tools.git"
  },
  "description": "全球代理的 MCP 工具、业务 Skills 与多 Agent 安装入口",
  "type": "module",
  "license": "MIT",
  "bin": {
    "quanqiudaili-agent-tools": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "dist/runtime",
    "skills",
    "spec/tools.json",
    "spec/dynamic-proxy-session.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build-skills && tsc -p tsconfig.json && tsx scripts/build-runtime.ts",
    "build-skills": "tsx scripts/build-skills.ts",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "sync-docs": "tsx scripts/sync-docs.ts",
    "build-spec": "tsx scripts/build-spec.ts"
  },
  "dependencies": {
    "@clack/prompts": "0.9.1",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/server": "^2.1.0",
    "add-mcp": "2.6.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^22",
    "esbuild": "0.28.2",
    "tsx": "^4.23",
    "typescript": "^5.9",
    "vitest": "^5",
    "yaml": "^2.9"
  }
}
