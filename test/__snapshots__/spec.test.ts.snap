          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "country",
      ],
      "type": "object",
    },
    "method": "GET",
    "name": "bandwidth_package_list",
    "path": "/externalapi/bandwidth/getBandwidthList",
    "readOnly": true,
    "title": "带宽套餐列表",
  },
  {
    "description": "查询单个时长类子账号在一段时间内的带宽使用趋势。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "endTime": {
          "description": "结束时间，Unix 秒级时间戳，只在 trend_type=2 时生效",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "startTime": {
          "description": "开始时间，Unix 秒级时间戳，只在 trend_type=2 时生效",
          "type": "integer",
        },
        "subAccount": {
          "description": "子账号 id，取 sub_account_list 返回的 id 字段",
          "type": "string",
        },
        "trend_type": {
          "description": "趋势类型：1=实时，固定最近 60 分钟，忽略时间参数；2=历史，按 startTime 和 endTime 取，跨度最多 2 天，不传默认最近 1 天",
          "enum": [
            1,
            2,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "subAccount",
        "trend_type",
      ],
      "type": "object",
    },
    "method": "GET",
    "name": "bandwidth_trend",
    "path": "/externalapi/bandwidth/monitoringTrend",
    "readOnly": true,
    "title": "子账号带宽趋势",
  },
  {
    "description": "只读试算子账号带宽升级费用，不下单、不扣费、不锁价或占用带宽。时长类产品传 sub_accounts 数组，下单用 order_bandwidth_upgrade；试算不检查同一国家和单次最多 300 个，不属于本人或产品不符的账号会被静默跳过，须核对试算对象。产品 11 只传本地 sub_account_id，返回 realPrice 总差价及 list 中的原带宽、目标带宽、剩余天数和到期时间，下单用 order_upgrade_dynamic_bandwidth。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "anyOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "sub_account_id",
                ],
              },
              {
                "properties": {
                  "product_type_id": {
                    "enum": [
                      11,
                    ],
                  },
                },
              },
            ],
          },
          "required": [
            "sub_accounts",
          ],
        },
        {
          "not": {
            "required": [
              "sub_accounts",
            ],
          },
          "properties": {
            "bandwidth_num": {
              "maximum": 1000,
              "minimum": 10,
              "multipleOf": 10,
            },
            "product_type_id": {
              "enum": [
                11,
              ],
            },
          },
          "required": [
            "sub_account_id",
          ],
        },
      ],
      "properties": {
        "bandwidth_num": {
          "description": "目标带宽。时长类填 bandwidth_package_list 返回的 num，且大于当前及未来各段带宽；产品 11 为 10-1000 Mbps、10 的倍数，必须高于当前带宽。",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心，11=动态住宅不限流量（按带宽计费）",
          "enum": [
            2,
            3,
            4,
            8,
            11,
          ],
          "type": "integer",
        },
        "sub_account_id": {
          "description": "产品 11 必填的本地子账号 ID，取列表 sub_account_id，不是 Go id；时长类产品不传。",
          "pattern": "^[1-9][0-9]*$",
          "type": "string",
        },
        "sub_accounts": {
          "description": "时长类产品必填的子账号 id 数组，取 sub_account_list 返回的 id；产品 11 不传。",
          "items": {
            "description": "子账号id。数组传递",
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "bandwidth_num",
        "product_type_id",
      ],
      "type": "object",
    },
    "method": "GET",
    "name": "bandwidth_upgrade_price",
    "path": "/externalapi/product_price/bandwidthUpgradePrice",
    "readOnly": true,
    "title": "带宽升级价格试算",
  },
  {
    "description": "查询动态住宅流量产品某国家下可选的城市。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
