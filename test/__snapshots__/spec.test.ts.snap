          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "sub_accounts": {
          "description": "要升级带宽的子账号 id 列表，取 sub_account_list 返回的 id 字段",
          "items": {
            "description": "子账号id。数组传递",
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "sub_accounts",
        "bandwidth_num",
        "product_type_id",
      ],
      "type": "object",
    },
    "method": "GET",
    "name": "bandwidth_upgrade_price",
    "path": "/externalapi/product_price/bandwidthUpgradePrice",
    "readOnly": true,
    "title": "带宽升级价格试算",
  },
  {
    "description": "查询动态住宅流量产品某国家下可选的城市。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
