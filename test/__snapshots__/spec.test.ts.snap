    "title": "动态产品州/省列表",
  },
  {
    "description": "会从账户余额扣费。为时长类子账号升级带宽，立即生效。所有子账号必须属于同一国家，单次最多 300 个，已过期的不能升级；失败时后端只返回笼统的"带宽升级订单创建失败"，所以先用 bandwidth_upgrade_price 试算并向用户确认。",
    "destructive": true,
    "fixed": {
      "pay_method": "balance",
    },
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bandwidth_num": {
          "description": "目标带宽，必须是 bandwidth_package_list 返回的某个档位的 num，且大于子账号当前带宽",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "subAccountIds": {
          "description": "要升级带宽的子账号 id 列表，取 sub_account_list 返回的 id 字段；和 bandwidth_upgrade_price 试算时是同一批子账号，只是那边的参数名叫 sub_accounts",
          "items": {
            "description": "子账号id。数组传递",
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "product_type_id",
        "subAccountIds",
        "bandwidth_num",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_bandwidth_upgrade",
    "path": "/externalapi/product_order/createBandwidthUpgradeOrder",
    "readOnly": false,
    "title": "带宽升级下单",
  },
  {
    "description": "会从账户余额扣费。购买动态住宅流量，num 为整数 GB 数，单次 1-5000，更大用量请联系客服；按本次购买量命中阶梯价，不要为沿用旧 300GB 限制自动拆单。产品 1 不限时长；产品 6 固定 30 天，到期没用完的流量会被扣掉。下单前用 product_unit_price 返回的 flowPriceBoard 匹配档位、user_balance 查余额，说明优惠额度与实际扣费边界并向用户确认。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bill_timelen": {
          "description": "产品 6 固定 30 天，省略时默认 1，也可显式传 1；产品 1 忽略。",
          "enum": [
            1,
          ],
          "type": "integer",
        },
        "num": {
          "description": "购买流量，单位 GB，单次整数 1-5000；按整单数量命中阶梯单价，不按旧 300GB 限制拆单。",
          "maximum": 5000,
          "minimum": 1,
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：1=动态住宅流量（不限时长），6=动态住宅流量（包月）",
          "enum": [
            1,
            6,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "num",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_buy_dynamic",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "readOnly": false,
    "title": "购买动态住宅流量",
  },
  {
    "description": "会从账户余额扣费。购买按带宽计费的动态不限流量（产品 11），每次创建一个子账号并立即发货；按网关、带宽和 30/90/180 天计费，创建后不能更换网关。先用 product_unit_price 传 product_type_id=11 和同样的网关、带宽、周期试算，实际扣费以下单为准；报价不保证库存充足。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bandwidth_num": {
          "description": "带宽，单位 Mbps，10-1000 且为 10 的倍数。",
          "maximum": 1000,
          "minimum": 10,
          "multipleOf": 10,
          "type": "integer",
        },
        "bill_timelen": {
          "description": "购买时长：1=30天，2=90天，3=180天",
          "enum": [
            1,
            2,
            3,
          ],
          "type": "integer",
        },
        "country": {
          "description": "接入网关国家码（ISO 3166-1）：US=美国、DE=德国、SG=新加坡；支持小写国家码，保留旧区域码 eu（对应 DE）；创建后不能更换，不用于指定代理出口国家",
          "enum": [
            "US",
            "DE",
            "SG",
            "us",
            "de",
            "sg",
            "eu",
          ],
          "type": "string",
        },
        "product_type_id": {
          "description": "产品类型：11=动态住宅不限流量（按带宽计费）",
          "enum": [
            11,
          ],
          "type": "integer",
        },
        "remark": {
          "description": "创建的子账号备注，可不传",
          "type": "string",
        },
        "user_conpon_id": {
          "description": "可选优惠券 ID，省略或 0 表示不用券；与报价传相同值，自定义价不与券叠加。",
          "pattern": "^[0-9]+$",
          "type": "string",
        },
      },
      "required": [
        "product_type_id",
        "bill_timelen",
        "country",
        "bandwidth_num",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_buy_dynamic_bandwidth",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "readOnly": false,
    "title": "购买动态住宅不限流量",
  },
  {
    "description": "会从账户余额扣费，金额是账号等级的测试单价 × 数量，另加带宽费，和时长无关。购买短期测试用的时长 IP，子账号建在调用者自己名下；只有已实名的代理商账号能调用，普通账号会被拒绝。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bandwidth_num": {
          "description": "带宽，单位 Mbps，不传默认 5。标准测试（timelen=12）只能选 5；10 和 15 只在特殊测试时长、且账号等级配了价格时可用",
          "enum": [
            5,
            10,
            15,
          ],
          "type": "integer",
        },
        "city": {
          "description": "城市名称，取 static_city_list 返回的 name 字段；不传则随机",
          "type": "string",
        },
        "country": {
          "description": "国家编码，必须大写，用 static_country_list 查。国家用 ISO 3166-1 二字码，如 US",
          "type": "string",
        },
        "num": {
          "description": "需要短期购买的子账号数量。范围：1-10之间",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "timelen": {
          "description": "测试时长档位，单位小时。传 12 表示标准测试，实际开通时长按账号等级配置（不一定是 12 小时）；账号有特殊测试配置时，可传配置里的小时数",
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "num",
        "timelen",
        "country",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_buy_test_ip",
    "path": "/externalapi/product_order/createTestOrder",
    "readOnly": false,
    "title": "购买时长测试 IP",
  },
  {
    "description": "会从账户余额扣费。购买静态住宅（2/3/4）或数据中心（8）时长 IP，num 为 IP 数量（1-300，数据中心单次最多 50）；数据中心不卖 7 天。下单前先用 stock_check 检测库存、product_unit_price 查价，并向用户确认。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "appoint_ip": {
          "description": "指定从哪些 IP 段购买，每项写一个 IP 段和该段要买的数量，所有 count 之和必须等于 num；不传则由系统随机分配。IP 段用 static_ip_range_list 查",
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "description": "该段要买的 IP 数量",
                "type": "integer",
              },
              "ip_str": {
                "description": "IP 段前两位，如 104.223，填 static_ip_range_list 返回的 ipStr 值",
                "type": "string",
              },
            },
            "type": "object",
          },
          "type": "array",
        },
        "bandwidth_num": {
          "description": "带宽加购，单位 Mbps，不传默认 5；可选档位和价格用 bandwidth_package_list 按产品和国家查，填返回的 num；数据中心（8）没有带宽加购，不要传",
          "type": "integer",
        },
        "city": {
          "description": "城市名称，取 static_city_list 返回的 name 字段；不传则随机",
          "type": "string",
        },
        "country": {
          "description": "国家编码，用 static_country_list 查。国家用 ISO 3166-1 二字码，如 US",
          "type": "string",
        },
        "exclude_ip_str": {
          "description": "排除ip段，多个以英文逗号分隔",
          "type": "string",
        },
        "num": {
          "description": "需要购买的 IP 数量，1-300；数据中心（8）单次最多 50",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "random_account_password": {
          "description": "是否生成随机账号密码:0=否,1=是(默认为0)",
          "enum": [
            0,
            1,
          ],
          "type": "integer",
        },
        "remark": {
          "description": "创建的子账号备注",
          "type": "string",
        },
        "timelen": {
          "description": "购买时长：0=7天，1=30天，2=90天，3=180天，4=360天；数据中心（8）不卖 7 天，不能选 0",
          "enum": [
            0,
            1,
            2,
            3,
            4,
          ],
          "type": "integer",
        },
        "use_ip_port": {
          "description": "是否开启ip端口连接:0=不开启,1=开启(默认为0)",
          "enum": [
            0,
            1,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "num",
        "timelen",
        "country",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_buy_time_ip",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "readOnly": false,
    "title": "购买时长 IP",
  },
  {
    "description": "为某个购买订单下的时长类子账号申请退单；不同订单的子账号请分别调用。只能退下单 1 天内、已支付、未开发票的购买订单，续费、赠送、带宽升级等订单都不能退；子账号有续费记录或带宽升级订单时不能退，申请过的子账号不能重复申请；单次可退数量有上限（默认 30 个）。提交后由上级代理商或平台审核，审核通过后这些子账号会被删除。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "ids": {
          "description": "要退的子账号 id 列表，取 sub_account_list 返回的 id 字段。这些子账号必须是同一个订单买出来的，订单看子账号列表里每条的 order_product_buy_id 字段",
          "items": {
            "description": "子账号id，对应子账号列表里的id",
            "type": "string",
          },
          "type": "array",
        },
        "order_product_buy_id": {
          "description": "订单id，对应子账号列表里的order_product_buy_id",
          "type": "integer",
        },
        "remark": {
          "description": "退单原因",
          "type": "string",
        },
      },
      "required": [
        "order_product_buy_id",
        "ids",
        "remark",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_refund_apply",
    "path": "/externalapi/order_back/createOrderBack",
    "readOnly": false,
    "title": "申请退单",
  },
  {
    "description": "审核通过后会删除并终止子账号，不可恢复。为动态不限流量的新购订单申请退单，由代理商或平台审核；仅限下单 1 天内、已支付、未开发票且无后续续费或升级记录的购买订单，不能重复申请。退款按审核时未使用天数折算，已用不足一天按一天扣除；每单对应一个子账号，不需要 ids。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "order_product_buy_id": {
          "description": "首个新购订单 ID，取 sub_account_list 产品 11 返回的 order_product_buy_id",
          "type": "integer",
        },
        "remark": {
          "description": "退单原因",
          "type": "string",
        },
      },
      "required": [
        "order_product_buy_id",
        "remark",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_refund_dynamic_bandwidth",
    "path": "/externalapi/order_back/createOrderBack",
    "readOnly": false,
    "title": "申请动态住宅不限流量退单",
  },
  {
    "description": "会从账户余额扣费。为时长类子账号续费，sub_account_ids 为逗号分隔的子账号 id。数据中心不能续 7 天。不会改动子账号的自动续费开关，但会把本次续费时长写成子账号以后自动续费的时长；renew_with_bandwidth 不传时沿用各子账号当前设置，子账号之间设置不一致时请分开续费。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "renew_with_bandwidth": {
          "description": "续费时是否包含带宽：1=按当前带宽续；0=不包含，续费期带宽按 5M 计价，当前带宽周期结束后回落到 5M。不传则沿用子账号当前的自动续费带宽设置；传了会同时改掉该设置",
          "enum": [
            0,
            1,
          ],
          "type": "integer",
        },
        "sub_account_ids": {
          "description": "要续费的子账号 id，多个用英文逗号连接；去空格、去空值、去重后一次最多 300 个，每个账号只续费一次",
          "type": "string",
        },
        "timelen": {
          "description": "续费时长：0=7天，1=30天，2=90天，3=180天，4=360天；数据中心（8）不能续 7 天，不能选 0",
          "enum": [
            0,
            1,
            2,
            3,
            4,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "timelen",
        "sub_account_ids",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_renew",
    "path": "/externalapi/product_order/createRenewProductBuyOrder",
    "readOnly": false,
    "title": "续费时长 IP",
  },
  {
    "description": "会从账户余额扣费。为动态不限流量子账号续费，按当前带宽和网关当前价计费，不改变带宽；未到期从原到期时间延长，已到期从当前时间起算，到期后 7 天内可续费。赠送测试账号或有待审核退单申请的账号不能续费；不支持自动续费。先用 product_unit_price 传 product_type_id=11、本地 sub_account_id 和同样周期试算，实际扣费以下单为准。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bill_timelen": {
          "description": "续费时长：1=30天，2=90天，3=180天",
          "enum": [
            1,
            2,
            3,
          ],
          "type": "integer",
        },
        "sub_account_id": {
          "description": "本地子账号 ID，必须取 sub_account_list 产品 11 返回的 sub_account_id，不是 id 字段",
          "type": "string",
        },
        "user_conpon_id": {
          "description": "优惠券 ID，可不传；自定义价不与优惠券叠加",
          "type": "string",
        },
      },
      "required": [
        "sub_account_id",
        "bill_timelen",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_renew_dynamic_bandwidth",
    "path": "/externalapi/product_order/createBandwidthRenewOrder",
    "readOnly": false,
    "title": "续费动态住宅不限流量",
  },
  {
    "description": "会从账户余额扣费。立即提高动态不限流量子账号的带宽，只升不降，到期时间不变；仅限未到期正式子账号。差价按新档月总价减原成交月总价，再乘剩余天数除以 30；剩余天数向上取整，不足一天按一天。不支持优惠券；先用 bandwidth_upgrade_price 传 product_type_id=11、本地 sub_account_id 和同样目标带宽试算，实际扣费以下单为准。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bandwidth_num": {
          "description": "目标带宽，单位 Mbps，必须大于当前带宽，10-1000 且为 10 的倍数。",
          "maximum": 1000,
          "minimum": 10,
          "multipleOf": 10,
          "type": "integer",
        },
        "sub_account_id": {
          "description": "本地子账号 ID，必须取 sub_account_list 产品 11 返回的 sub_account_id，不是 id 字段",
          "type": "string",
        },
      },
      "required": [
        "sub_account_id",
        "bandwidth_num",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_upgrade_dynamic_bandwidth",
    "path": "/externalapi/product_order/createBandwidthUpgradeOrderForDrfbw",
    "readOnly": false,
    "title": "升级动态住宅不限流量带宽",
  },
  {
    "description": "查询平台启用的产品列表，返回产品 id、名称和账号后缀。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object",
    },
    "method": "GET",
    "name": "product_list",
    "path": "/externalapi/conpons/getProductList",
    "readOnly": true,
    "title": "产品信息",
  },
  {
    "description": "不传参数时查询当前账号各产品的单价和自定义价额度。动态流量产品 1/6 按购买 GB 数匹配 flowPriceBoard 的 tiers（min_gb/max_gb），origin_price/custom_price 是元/GB；custom_price 为空时用官网价，优惠价是否生效还受额度影响，不能用首档价计算所有数量；产品 6 固定 30 天。时长类按 7/30/90/180/360 天返回 originUnitPrice/userUnitPrice，customPriceBalance 是自定义价额度，产品 7 可忽略。传 product_type_id=11 时只读试算动态不限流量的新购或续费：新购传 country、bandwidth_num、bill_timelen；续费传本地 sub_account_id、bill_timelen，沿用账号网关和带宽。realPrice 是预计总金额，单位元；续费另返回 new_expire_time。不锁价、不占库存或优惠额度，实际扣费以下单为准。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "anyOf": [
        {
          "maxProperties": 0,
        },
        {
          "not": {
            "required": [
              "sub_account_id",
            ],
          },
          "required": [
            "product_type_id",
            "country",
            "bandwidth_num",
            "bill_timelen",
          ],
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "country",
                ],
              },
              {
                "required": [
                  "bandwidth_num",
                ],
              },
            ],
          },
          "required": [
            "product_type_id",
            "sub_account_id",
            "bill_timelen",
          ],
        },
      ],
      "properties": {
        "bandwidth_num": {
          "description": "新购报价必填的带宽，单位 Mbps，10-1000 且为 10 的倍数；续费沿用当前带宽，不传。",
          "maximum": 1000,
          "minimum": 10,
          "multipleOf": 10,
          "type": "integer",
        },
        "bill_timelen": {
          "description": "产品 11 报价必填的周期，1=30天、2=90天、3=180天。",
          "enum": [
            1,
            2,
            3,
          ],
          "type": "integer",
        },
        "country": {
          "description": "新购报价必填的接入网关国家码（ISO 3166-1）；旧区域 eu 请改用 DE，不用于指定代理出口国家；续费不传。",
          "enum": [
            "US",
            "DE",
            "SG",
            "us",
            "de",
            "sg",
          ],
          "type": "string",
        },
        "product_type_id": {
          "description": "仅产品 11 报价时传 11；省略且不传其他参数时查询原有产品单价表。",
          "enum": [
            11,
          ],
          "type": "integer",
        },
        "sub_account_id": {
          "description": "续费报价时传本地子账号 ID，取产品 11 列表的 sub_account_id；不要传 Go id。省略时为新购报价。",
          "pattern": "^[1-9][0-9]*$",
          "type": "string",
        },
        "user_conpon_id": {
          "description": "可选优惠券 ID，省略或 0 表示不用券；报价和下单使用同一张券，自定义价不与券叠加。",
          "pattern": "^[0-9]+$",
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "method": "GET",
    "name": "product_unit_price",
    "path": "/externalapi/product_price/getProductUnitPrice",
    "readOnly": true,
    "title": "产品单价",
  },
  {
