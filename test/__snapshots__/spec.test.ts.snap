  },
  {
    "description": "查询动态住宅流量产品（product_type_id 1 或 6）可选的国家及编码。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "product_type_id": {
          "description": "产品类型：1=动态住宅流量（不限时长），6=动态住宅流量（包月）",
