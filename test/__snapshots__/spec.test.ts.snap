        "country_code": {
          "description": "国家编码，用 dynamic_country_list 查。国家用 ISO 3166-1 二字码，如 US",
          "type": "string",
        },
        "product_type_id": {
          "description": "产品类型：1=动态住宅流量（不限时长），6=动态住宅流量（包月）",
