          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "country",
      ],
      "type": "object",
    },
    "method": "GET",
    "name": "bandwidth_package_list",
    "path": "/externalapi/bandwidth/getBandwidthList",
    "readOnly": true,
    "title": "带宽套餐列表",
  },
  {
    "description": "查询单个时长类子账号在一段时间内的带宽使用趋势。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "endTime": {
          "description": "结束时间，Unix 秒级时间戳，只在 trend_type=2 时生效",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "startTime": {
          "description": "开始时间，Unix 秒级时间戳，只在 trend_type=2 时生效",
          "type": "integer",
        },
        "subAccount": {
          "description": "子账号 id，取 sub_account_list 返回的 id 字段",
          "type": "string",
        },
        "trend_type": {
          "description": "趋势类型：1=实时，固定最近 60 分钟，忽略时间参数；2=历史，按 startTime 和 endTime 取，跨度最多 2 天，不传默认最近 1 天",
          "enum": [
            1,
            2,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "subAccount",
        "trend_type",
      ],
      "type": "object",
    },
