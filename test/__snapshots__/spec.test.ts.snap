  {
    "description": "为动态子账号设置流量上限；limit_flow 为 0 表示取消限制。新上限低于已用量时，该子账号会立即停用并断开正在使用的连接；调高上限（不低于已用量）或设为 0 会解除停用。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "子账号 id，取 sub_account_list 返回的 id 字段",
          "type": "string",
        },
