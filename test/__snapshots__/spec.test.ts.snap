  {
    "description": "为动态住宅流量产品（1 或 6）新增子账号，不扣费。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "agree": {
          "description": "协议，大写；不传默认 SOCKS5",
          "enum": [
            "SOCKS5",
            "HTTP",
            "HTTPS",
          ],
          "type": "string",
        },
        "changeInterval": {
          "description": "IP切换周期，5-120分钟可选",
          "type": "integer",
        },
        "country": {
          "description": "国家编码，用 dynamic_country_list 查；不传或传 ALL 为全球。国家用 ISO 3166-1 二字码，如 US",
          "type": "string",
        },
        "limit_flow": {
          "description": "流量上限，单位 GB，0 到 1000000，0 或不传为不限",
          "type": "integer",
        },
        "num": {
          "description": "需要生成的子账号数量。范围 1-300",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：1=动态住宅流量（不限时长），6=动态住宅流量（包月）",
          "enum": [
            1,
            6,
          ],
          "type": "integer",
        },
        "url": {
