    "name": "dynamic_state_list",
    "path": "/externalapi/common/stateList",
    "readOnly": true,
    "title": "动态产品州/省列表",
  },
  {
    "description": "会从账户余额扣费。为时长类子账号升级带宽，立即生效。所有子账号必须属于同一国家，单次最多 300 个，已过期的不能升级；失败时后端只返回笼统的"带宽升级订单创建失败"，所以先用 bandwidth_upgrade_price 试算并向用户确认。",
    "destructive": true,
    "fixed": {
      "pay_method": "balance",
    },
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bandwidth_num": {
          "description": "目标带宽，必须是 bandwidth_package_list 返回的某个档位的 num，且大于子账号当前带宽",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "subAccountIds": {
          "description": "要升级带宽的子账号 id 列表，取 sub_account_list 返回的 id 字段；和 bandwidth_upgrade_price 试算时是同一批子账号，只是那边的参数名叫 sub_accounts",
          "items": {
            "description": "子账号id。数组传递",
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "product_type_id",
        "subAccountIds",
        "bandwidth_num",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_bandwidth_upgrade",
    "path": "/externalapi/product_order/createBandwidthUpgradeOrder",
    "readOnly": false,
    "title": "带宽升级下单",
  },
  {
    "description": "会从账户余额扣费。购买动态住宅流量，num 为 GB 数（1-300，要买更多请分几次下单）：产品 1 不限时长；产品 6 为包月，一次性加 num GB，有效期由 bill_timelen 决定，到期没用完的流量会被扣掉。下单前先用 product_unit_price 查价、user_balance 查余额，并向用户确认。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bill_timelen": {
          "description": "包月有效时长：1=30天，2=90天，3=180天；产品 6 必填，产品 1 忽略",
          "enum": [
            1,
            2,
            3,
          ],
          "type": "integer",
        },
        "num": {
          "description": "需要购买的流量数量。单位：GB。范围：1-300GB之间。如果要购买更多，请多次请求",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：1=动态住宅流量（不限时长），6=动态住宅流量（包月）",
          "enum": [
            1,
            6,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "num",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_buy_dynamic",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "readOnly": false,
    "title": "购买动态住宅流量",
  },
  {
    "description": "会从账户余额扣费，金额是账号等级的测试单价 × 数量，另加带宽费，和时长无关。购买短期测试用的时长 IP，子账号建在调用者自己名下；只有已实名的代理商账号能调用，普通账号会被拒绝。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bandwidth_num": {
          "description": "带宽，单位 Mbps，不传默认 5。标准测试（timelen=12）只能选 5；10 和 15 只在特殊测试时长、且账号等级配了价格时可用",
          "enum": [
            5,
            10,
            15,
          ],
          "type": "integer",
        },
        "city": {
          "description": "城市名称，取 static_city_list 返回的 name 字段；不传则随机",
          "type": "string",
        },
        "country": {
          "description": "国家编码，必须大写，用 static_country_list 查。国家用 ISO 3166-1 二字码，如 US",
          "type": "string",
        },
        "num": {
          "description": "需要短期购买的子账号数量。范围：1-10之间",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "timelen": {
          "description": "测试时长档位，单位小时。传 12 表示标准测试，实际开通时长按账号等级配置（不一定是 12 小时）；账号有特殊测试配置时，可传配置里的小时数",
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "num",
        "timelen",
        "country",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_buy_test_ip",
    "path": "/externalapi/product_order/createTestOrder",
    "readOnly": false,
    "title": "购买时长测试 IP",
  },
  {
    "description": "会从账户余额扣费。购买静态住宅（2/3/4）或数据中心（8）时长 IP，num 为 IP 数量（1-300，数据中心单次最多 50）；数据中心不卖 7 天。下单前先用 stock_check 检测库存、product_unit_price 查价，并向用户确认。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "appoint_ip": {
          "description": "指定从哪些 IP 段购买，每项写一个 IP 段和该段要买的数量，所有 count 之和必须等于 num；不传则由系统随机分配。IP 段用 static_ip_range_list 查",
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "description": "该段要买的 IP 数量",
                "type": "integer",
              },
              "ip_str": {
                "description": "IP 段前两位，如 104.223，填 static_ip_range_list 返回的 ipStr 值",
                "type": "string",
              },
            },
            "type": "object",
          },
          "type": "array",
        },
        "bandwidth_num": {
          "description": "带宽加购，单位 Mbps，不传默认 5；可选档位和价格用 bandwidth_package_list 按产品和国家查，填返回的 num；数据中心（8）没有带宽加购，不要传",
          "type": "integer",
        },
        "city": {
          "description": "城市名称，取 static_city_list 返回的 name 字段；不传则随机",
          "type": "string",
        },
        "country": {
          "description": "国家编码，用 static_country_list 查。国家用 ISO 3166-1 二字码，如 US",
          "type": "string",
        },
        "exclude_ip_str": {
          "description": "排除ip段，多个以英文逗号分隔",
          "type": "string",
        },
        "num": {
          "description": "需要购买的 IP 数量，1-300；数据中心（8）单次最多 50",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "random_account_password": {
          "description": "是否生成随机账号密码:0=否,1=是(默认为0)",
          "enum": [
            0,
            1,
          ],
          "type": "integer",
        },
        "remark": {
          "description": "创建的子账号备注",
          "type": "string",
        },
        "timelen": {
          "description": "购买时长：0=7天，1=30天，2=90天，3=180天，4=360天；数据中心（8）不卖 7 天，不能选 0",
          "enum": [
            0,
            1,
            2,
            3,
            4,
          ],
          "type": "integer",
        },
        "use_ip_port": {
          "description": "是否开启ip端口连接:0=不开启,1=开启(默认为0)",
          "enum": [
            0,
            1,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "num",
        "timelen",
        "country",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_buy_time_ip",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "readOnly": false,
    "title": "购买时长 IP",
  },
  {
    "description": "为某个购买订单下的时长类子账号申请退单；不同订单的子账号请分别调用。只能退下单 1 天内、已支付、未开发票的购买订单，续费、赠送、带宽升级等订单都不能退；子账号有续费记录或带宽升级订单时不能退，申请过的子账号不能重复申请；单次可退数量有上限（默认 30 个）。提交后由上级代理商或平台审核，审核通过后这些子账号会被删除。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "ids": {
          "description": "要退的子账号 id 列表，取 sub_account_list 返回的 id 字段。这些子账号必须是同一个订单买出来的，订单看子账号列表里每条的 order_product_buy_id 字段",
          "items": {
            "description": "子账号id，对应子账号列表里的id",
            "type": "string",
          },
          "type": "array",
        },
        "order_product_buy_id": {
          "description": "订单id，对应子账号列表里的order_product_buy_id",
          "type": "integer",
        },
        "remark": {
          "description": "退单原因",
          "type": "string",
        },
      },
      "required": [
        "order_product_buy_id",
        "ids",
        "remark",
      ],
      "type": "object",
    },
    "method": "POST",
    "name": "order_refund_apply",
    "path": "/externalapi/order_back/createOrderBack",
    "readOnly": false,
    "title": "申请退单",
  },
  {
    "description": "会从账户余额扣费。为时长类子账号续费，sub_account_ids 为逗号分隔的子账号 id。数据中心不能续 7 天。不会改动子账号的自动续费开关，但会把本次续费时长写成子账号以后自动续费的时长；renew_with_bandwidth 不传时沿用各子账号当前设置，子账号之间设置不一致时请分开续费。",
    "destructive": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "product_type_id": {
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8,
          ],
          "type": "integer",
        },
        "renew_with_bandwidth": {
          "description": "续费时是否包含带宽：1=按当前带宽续；0=不包含，续费期带宽按 5M 计价，当前带宽周期结束后回落到 5M。不传则沿用子账号当前的自动续费带宽设置；传了会同时改掉该设置",
          "enum": [
            0,
            1,
          ],
          "type": "integer",
        },
        "sub_account_ids": {
          "description": "要续费的子账号 id，多个用英文逗号连接，一次最多 300 个",
          "type": "string",
        },
        "timelen": {
          "description": "续费时长：0=7天，1=30天，2=90天，3=180天，4=360天；数据中心（8）不能续 7 天，不能选 0",
          "enum": [
            0,
            1,
            2,
            3,
