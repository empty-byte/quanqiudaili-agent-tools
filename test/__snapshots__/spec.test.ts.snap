  },
  {
    "description": "分页查询子账号，覆盖全部产品类型，含动态不限流量（11）。产品 11 的 id 是 Go 子账号 ID，用于 ids 筛选；续费和升级必须取 sub_account_id（本地 ID），退单取 order_product_buy_id。返回用户名、密码、端口、协议、国家、流量等。旧产品按 searchArr 批量搜索时，零命中可能返回全部子账号，要核对返回的是不是要找的子账号。",
    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "country": {
          "description": "按国家筛选。动态产品用 dynamic_country_list 查编码，时长类产品用 static_country_list。国家用 ISO 3166-1 二字码，如 US",
          "type": "string",
        },
        "exportIp": {
          "description": "按出口 IP 筛选，可填完整 IP 或前缀（如 104.223），按前缀匹配",
          "type": "string",
        },
        "ids": {
          "description": "子账号id集合，多个以英文逗号连接",
          "type": "string",
        },
        "page": {
          "description": "当前页数",
          "type": "integer",
        },
        "pagesize": {
          "description": "每页显示数量。每页最大100条数据",
          "type": "integer",
        },
        "product_type_id": {
          "description": "产品类型：1=动态住宅流量（不限时长），2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），6=动态住宅流量（包月），8=数据中心，11=动态住宅不限流量（按带宽计费）",
          "enum": [
            1,
            2,
            3,
            4,
            6,
            8,
            11,
          ],
          "type": "integer",
        },
        "remark": {
          "description": "子账号备注(模糊匹配)",
          "type": "string",
        },
        "searchArr": {
          "description": "搜索的值列表，内容由 search_type 决定：子账号名、出口 IP 或备注关键词，一次最多 100 个。时长类产品（2/3/4/8）与动态不限流量（11）支持这些搜索；流量产品（1/6）只能按自定义用户名搜 1 个",
          "items": {
            "description": "单个搜索值",
            "type": "string",
          },
          "type": "array",
        },
        "search_type": {
          "description": "搜索类型，和 searchArr 一起用：0=按子账号名精确找（时长类用自定义用户名），1=按出口 IP 精确找，2=按备注模糊找",
          "enum": [
            0,
            1,
            2,
          ],
          "type": "integer",
        },
      },
      "required": [
        "product_type_id",
        "page",
        "pagesize",
      ],
      "type": "object",
    },
