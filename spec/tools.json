[
  {
    "name": "bandwidth_detail",
    "title": "有效期内带宽详情",
    "description": "查询子账号剩余有效期内已购带宽的详情。",
    "readOnly": true,
    "destructive": false,
    "method": "GET",
    "path": "/externalapi/bandwidth/bandwidthNumDetail",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8
          ]
        },
        "subAccount": {
          "type": "string",
          "description": "子账号 id，取 sub_account_list 返回的 id 字段"
        }
      },
      "required": [
        "product_type_id",
        "subAccount"
      ],
      "additionalProperties": false
    }
  },
  {
