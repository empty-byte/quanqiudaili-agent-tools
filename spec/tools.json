  {
    "name": "order_bandwidth_upgrade",
    "title": "带宽升级下单",
    "description": "会从账户余额扣费。为时长类子账号升级带宽，先用 bandwidth_upgrade_price 试算并向用户确认。",
    "readOnly": false,
    "destructive": true,
    "method": "POST",
    "path": "/externalapi/product_order/createBandwidthUpgradeOrder",
    "fixed": {
      "pay_method": "balance"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8
          ]
        },
        "subAccountIds": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "子账号id。数组传递"
          },
          "description": "要升级带宽的子账号 id 列表，取 sub_account_list 返回的 id 字段；和 bandwidth_upgrade_price 试算时是同一批子账号，只是那边的参数名叫 sub_accounts"
        },
        "bandwidth_num": {
          "type": "integer",
          "description": "要升级的带宽值，升级的带宽值要大于现在的带宽值"
        }
      },
      "required": [
        "product_type_id",
        "subAccountIds",
        "bandwidth_num"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "order_buy_dynamic",
    "title": "购买动态住宅流量",
    "description": "会从账户余额扣费。购买动态住宅流量，num 为 GB 数（1-300，要买更多请分几次下单）：产品 1 不限时长；产品 6 为包月，num 是每月的 GB 数，bill_timelen 指定有效时长档位。下单前先用 product_unit_price 查价、user_info 查余额，并向用户确认。",
    "readOnly": false,
    "destructive": true,
    "method": "POST",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：1=动态住宅流量（不限时长），6=动态住宅流量（包月）",
          "enum": [
            1,
            6
          ]
        },
        "num": {
          "type": "integer",
          "description": "需要购买的流量数量。单位：GB。范围：1-300GB之间。如果要购买更多，请多次请求"
        },
        "bill_timelen": {
          "type": "integer",
          "description": "包月有效时长：1=30天，2=90天，3=180天；产品 6 必填，产品 1 忽略",
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "required": [
        "product_type_id",
        "num"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "order_buy_test_ip",
    "title": "购买时长测试 IP",
    "description": "会从账户余额按时长扣费。购买短期测试用的时长 IP，用于自有平台给用户试用；只有代理商账号能调用，普通账号会被拒绝。",
    "readOnly": false,
    "destructive": true,
    "method": "POST",
    "path": "/externalapi/product_order/createTestOrder",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8
          ]
        },
        "num": {
          "type": "integer",
          "description": "需要短期购买的子账号数量。范围：1-10之间"
        },
        "timelen": {
          "type": "integer",
          "description": "测试时长，单位小时；普通账号固定传 12"
        },
        "agree": {
          "type": "string",
          "description": "协议，大写",
          "enum": [
            "SOCKS5",
            "HTTP",
            "HTTPS"
          ]
        },
        "country": {
          "type": "string",
          "description": "国家编码，用 static_country_list 查。国家用 ISO 3166-1 二字码，如 US"
        },
        "city": {
          "type": "string",
          "description": "城市名称，取 static_city_list 返回的 name 字段；不传则随机"
        },
        "bandwidth_num": {
          "type": "integer",
          "description": "带宽，单位 Mbps，不传默认 5；10 和 15 是否可选取决于账号等级配置",
          "enum": [
            5,
            10,
            15
          ]
        }
      },
      "required": [
        "product_type_id",
        "num",
        "timelen",
        "agree",
        "country"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "order_buy_time_ip",
    "title": "购买时长 IP",
    "description": "会从账户余额扣费。购买静态住宅（2/3/4）或数据中心（8）时长 IP，num 为 IP 数量（1-300，数据中心单次最多 50）；数据中心不卖 7 天。下单前先用 stock_check 检测库存、product_unit_price 查价，并向用户确认。",
    "readOnly": false,
    "destructive": true,
    "method": "POST",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8
          ]
        },
        "num": {
          "type": "integer",
          "description": "需要购买的 IP 数量，1-300；数据中心（8）单次最多 50"
        },
        "timelen": {
          "type": "integer",
          "description": "购买时长：0=7天，1=30天，2=90天，3=180天，4=360天；数据中心（8）不卖 7 天，不能选 0",
          "enum": [
            0,
            1,
            2,
            3,
            4
          ]
        },
        "agree": {
          "type": "string",
          "description": "协议，大写",
          "enum": [
            "SOCKS5",
            "HTTP",
            "HTTPS"
          ]
        },
        "country": {
          "type": "string",
          "description": "国家编码，用 static_country_list 查。国家用 ISO 3166-1 二字码，如 US"
        },
        "city": {
          "type": "string",
          "description": "城市名称，取 static_city_list 返回的 name 字段；不传则随机"
        },
        "appoint_ip": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ip_str": {
                "type": "string",
                "description": "IP 段前两位，如 104.223，填 static_ip_range_list 返回的 ipStr 值"
              },
              "count": {
                "type": "integer",
                "description": "该段要买的 IP 数量，不能超过列表里该段的 num"
              }
            },
            "additionalProperties": false
          },
          "description": "指定从哪些 IP 段购买，每项写一个 IP 段和该段要买的数量，所有 count 之和必须等于 num；不传则由系统随机分配。IP 段用 static_ip_range_list 查"
        },
        "exclude_ip_str": {
          "type": "string",
          "description": "排除ip段，多个以英文逗号分隔"
        },
        "bandwidth_num": {
          "type": "integer",
          "description": "带宽加购，单位 Mbps，不传默认 5；可选档位和价格用 bandwidth_package_list 按产品和国家查，填返回的 num；数据中心（8）没有带宽加购，不要传"
        },
        "remark": {
          "type": "string",
          "description": "创建的子账号备注"
        },
        "use_ip_port": {
          "type": "integer",
          "description": "是否开启ip端口连接:0=不开启,1=开启(默认为0)",
          "enum": [
            0,
            1
          ]
        },
        "random_account_password": {
          "type": "integer",
          "description": "是否生成随机账号密码:0=否,1=是(默认为0)",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "product_type_id",
        "num",
        "timelen",
        "agree",
        "country"
      ],
      "additionalProperties": false
    }
  },
  {
